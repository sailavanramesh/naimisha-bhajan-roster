// Naimisha Bhajan Roster — v2 schema.
//
// Changes from v1 follow docs/SPEC.md §5. Read that before editing.
//
// Two columns in this file are historical record and must never be recomputed,
// overwritten, or "cleaned up": SessionSlot.confirmedPitch (what the singer
// actually sang) and SessionSlot.historicalRecommendedPitch (what the sheet
// recommended at the time). The 709 rows carrying them exist nowhere else.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Which reference-pitch track in the masterlist applies to a singer.
/// These are the group's own words; do not translate them.
enum Gender {
  Gents
  Ladies
}

/// Which drone the shruti box plays against Sa. Display metadata only —
/// it does NOT change the pitch. See CLAUDE.md rule 2.
enum Series {
  Madhyam
  Pancham
}

enum SessionType {
  Weekday
  Sunday
  Festival
}

enum SessionStatus {
  Draft
  Published
}

/// A singer's relationship to a bhajan.
///
/// `known` and `festival` came from the import. `wantToLearn` and `learning`
/// are the personal list: a singer moves a bhajan along until they are
/// confident, and graduating it to `known` makes it count in the session
/// builder's repertoire scoring with no other wiring.
enum RepertoireKind {
  known
  /// DEAD as of 2026-08-12 — see SingerRepertoire.isFestival. No row should
  /// carry it; the value stays only because dropping an enum value in Postgres
  /// means rewriting the column, and an unused value costs nothing.
  festival
  wantToLearn
  learning
}

/// Slot rules are mostly advisory. Confirmed with Sailavan (SPEC §9.1): the
/// Ganesha opener and the Sai closer are strong habits, not rules. A `soft`
/// violation is down-weighted and surfaced; it never fails generation.
enum RuleStrength {
  hard
  soft
}

/// Where a bhajan came from. Everything imported from data/roster.xlsx is
/// `masterlist`; anything typed into the app afterwards is `local`, so the
/// group can tell its own additions from the Sai Rhythms masterlist without
/// the distinction being shouted at them.
enum BhajanOrigin {
  masterlist
  local
}

enum Role {
  /// Everything a coordinator can do, plus the notification rules. See
  /// lib/auth.ts — the app deliberately had no owner until the rules for when
  /// people get reminded became something to configure rather than to deploy.
  owner
  coordinator
  singer
  viewer
}

/// When the day-of reminders go out, for one scope.
///
/// The 3pm and 5pm in lib/notify.ts are the fallback. Most sessions are in the
/// evening but some are mornings, and a reminder at 3pm for a session that
/// finished at noon is worse than none — so an owner can say "Sunday runs in
/// the morning" once, or override a single festival, without a deploy.
///
/// Most specific wins: a rule on the session beats one on its weekday, which
/// beats the default. See lib/nudgeRules.ts, where the resolution lives as a
/// pure function.
model NotificationRule {
  id String @id @default(cuid())

  scope RuleScope

  /// 0 = Sunday … 6 = Saturday. Only for scope = weekday.
  weekday   Int?
  /// Only for scope = session.
  sessionId String?

  /// Melbourne hour, 0–23, for the first reminder.
  firstHour     Int
  /// The second and last one. Null means there is only ever one.
  finalHour     Int?
  /// Never send after this hour — people are on their way by then.
  stopAfterHour Int

  /// Off means this scope sends nothing at all.
  enabled Boolean @default(true)

  /// Who last touched it, for the Admin screen. A name, not an id.
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([scope, weekday, sessionId])
  @@index([sessionId])
}

enum RuleScope {
  /// The one rule that applies when nothing more specific does.
  default
  weekday
  session
}

model Singer {
  id        String   @id @default(cuid())
  name      String   @unique
  gender    Gender?
  /// Google account address, set by a coordinator. Sign-in never creates a
  /// singer; an unlisted address gets viewer access only (SPEC §9.5).
  email     String?  @unique
  role      Role     @default(singer)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots             SessionSlot[]
  repertoire        SingerRepertoire[]
  availability      SingerAvailability[]
  micCushions       MicCushion[]
  pushSubscriptions PushSubscription[]
  notices           SessionNotice[]
}

model Bhajan {
  id       String  @id @default(cuid())
  title    String  @unique
  url      String?
  singers  String?
  meaning  String? @db.Text
  lyrics   String? @db.Text
  audio    String?
  /// Raw comma/space-delimited source values, kept for provenance.
  /// Query through the join tables below, never with LIKE.
  deity    String?
  language String?
  raga     String?
  beat     String?
  level    String?
  tempo    String?

  referenceGentsPitch      String?
  referenceLadiesPitch     String?
  musicNotesForFirstLine   String? @db.Text
  notesRange               String?
  tutorial                 String?
  sheetMusic               String?
  songTags                 String?
  glossaryTerms            String? @db.Text
  debugFile                String?
  video                    String?
  generalComments          String? @db.Text
  karaokeTracksForPractice String? @db.Text
  goldenVoice              String?
  instrumental             String?
  extra                    String?

  /// See BhajanOrigin. Defaults to masterlist so the 3,607 imported rows are
  /// unaffected by this column being added.
  origin     BhajanOrigin @default(masterlist)
  /// Free-text note on a locally added bhajan — where it came from, who asked.
  originNote String?

  /// Generated column maintained by Postgres — see the migration. Not
  /// selectable through the client; search via $queryRaw against the GIN index.
  searchVector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots      SessionSlot[]
  repertoire SingerRepertoire[]
  deities    BhajanDeity[]
  tags       BhajanTag[]

  @@index([searchVector], type: Gin)
  @@index([raga])
  @@index([tempo])
}

/// 21 values, `Sarva Dharma` meaning multi-faith. A bhajan may list several.
model Deity {
  id   String @id @default(cuid())
  name String @unique

  bhajans BhajanDeity[]
}

model BhajanDeity {
  bhajanId String
  deityId  String

  bhajan Bhajan @relation(fields: [bhajanId], references: [id], onDelete: Cascade)
  deity  Deity  @relation(fields: [deityId], references: [id], onDelete: Cascade)

  @@id([bhajanId, deityId])
  @@index([deityId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  bhajans BhajanTag[]
}

model BhajanTag {
  bhajanId String
  tagId    String

  bhajan Bhajan @relation(fields: [bhajanId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bhajanId, tagId])
  @@index([tagId])
}

model Session {
  id         String        @id @default(cuid())
  /// A session date, not a timestamp. Handled in Australia/Melbourne.
  date       DateTime      @unique @db.Date
  type       SessionType   @default(Weekday)
  status     SessionStatus @default(Published)
  /// Seed for the generator, so a generated set is reproducible and shareable.
  seed       String?
  templateId String?
  notes      String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  template          SessionTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  slots             SessionSlot[]
  instruments       SessionInstrument[]
  micCushions       MicCushion[]
  notices           SessionNotice[]
  notificationRules NotificationRule[]

  @@index([templateId])
  @@index([date])
}

/// One ordered slot in a session: a singer, a bhajan, and the pitch they sang.
/// Renamed from v1's `SessionSinger`; `slot Int?` became `position Int`.
model SessionSlot {
  id        String  @id @default(cuid())
  sessionId String
  /// Null until a singer is assigned. The session builder chooses bhajans
  /// first and drafts a session with unassigned slots; rostering fills these
  /// in. Also `SetNull` rather than `Cascade`: removing a singer must never
  /// silently delete their confirmedPitch history.
  singerId  String?
  bhajanId  String?
  /// Ordered from 1. Order carries meaning — the set builds.
  position  Int

  /// Free-text fallbacks preserved from the sheet for rows whose title does not
  /// resolve to a masterlist bhajan.
  bhajanTitle           String?
  festivalBhajanTitle   String?
  inputOnlyCustomBhajan String?

  /// HISTORICAL RECORD. What the singer actually sang at. Differs from the
  /// recommendation in 381 of 611 rows; that difference is the product.
  /// Never overwrite this with a computed value.
  confirmedPitch String?

  /// HISTORICAL RECORD. The recommendation as it stood in the source sheet
  /// (`Recommended Pitch as Sai Rythms`). CLAUDE.md rule 5 says the app's live
  /// recommendation is derived from the masterlist and never stored — that
  /// still holds, and nothing reads this column to produce one. It is kept
  /// because the singer-offset regression table is defined against it and must
  /// reproduce from the database. Of the 618 rows where both this and a
  /// masterlist reference exist, 617 agree; the one that does not is a known
  /// typo, logged at seed time.
  historicalRecommendedPitch String?

  alternativeTablaPitch String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  singer  Singer? @relation(fields: [singerId], references: [id], onDelete: SetNull)
  bhajan  Bhajan? @relation(fields: [bhajanId], references: [id], onDelete: SetNull)

  @@unique([sessionId, position])
  @@index([sessionId])
  @@index([singerId])
  @@index([bhajanId])
}

model SessionInstrument {
  id         String  @id @default(cuid())
  sessionId  String
  instrument String
  person     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// What a singer knows or has curated for a festival. Replaces v1's
/// `FestivalBhajan` and the two wide sheets it came from.
model SingerRepertoire {
  id       String         @id @default(cuid())
  singerId String
  bhajanId String?
  /// Title as written in the source sheet, kept even when it resolves.
  title    String
  kind     RepertoireKind
  order    Int?

  /// This is one of the bhajans they do at festivals.
  ///
  /// A FLAG, not a stage. `festival` used to be a value of RepertoireKind,
  /// which meant the same bhajan appeared twice on a singer's page — once as
  /// "festival" and once as "known" — because the two came from two different
  /// sheets at seed time. Sailavan, 2026-08-12: "festival songs are not songs
  /// that were sung, they were just songs for people to learn or that they
  /// know." Being a festival bhajan describes the song; wanting to learn it,
  /// learning it and knowing it are the stages, and a song is at exactly one
  /// of them.
  isFestival Boolean @default(false)

  /// The singer's own note — what they are finding hard, where they heard it.
  /// Visible to them and to editors only.
  note           String?
  /// The shruti this singer wants for it, if they have settled on one.
  /// Overrides the derived recommendation for them on this bhajan.
  preferredPitch String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  singer Singer  @relation(fields: [singerId], references: [id], onDelete: Cascade)
  bhajan Bhajan? @relation(fields: [bhajanId], references: [id], onDelete: SetNull)

  @@unique([singerId, kind, title])
  @@index([singerId])
  @@index([bhajanId])
}

model SingerAvailability {
  id        String   @id @default(cuid())
  singerId  String
  date      DateTime @db.Date
  available Boolean  @default(true)
  note      String?

  singer Singer @relation(fields: [singerId], references: [id], onDelete: Cascade)

  @@unique([singerId, date])
  @@index([date])
}

/// Templates are data, editable in the UI. Do not hard-code them.
model SessionTemplate {
  id            String  @id @default(cuid())
  name          String  @unique
  description   String?
  /// Default session length. 3, per SPEC §9.2.
  defaultLength Int     @default(3)
  isDefault     Boolean @default(false)
  /// Festival mode: constrain every slot to this deity, as a HARD rule.
  /// Null for ordinary templates. Generalises beyond Shivaratri (SPEC §4.G).
  singleDeity   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules    SlotRule[]
  sessions Session[]
}

model SlotRule {
  id         String       @id @default(cuid())
  templateId String
  /// 1-based. Negative counts from the end: -1 is the final slot.
  position   Int
  strength   RuleStrength @default(soft)
  /// Constraint fields. Null means "no constraint on this dimension".
  deity      String?
  tempoIn    String[]     @default([])
  note       String?

  template SessionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@index([templateId])
}

/// The 24 shruti labels. Renamed from v1's `PitchLookup`; the pitch maths is
/// now first-class columns rather than something parsed at read time.
model PitchLabel {
  id         String  @id @default(cuid())
  label      String  @unique
  /// The numeric step in the label, e.g. 2.5 in `2.5 Madhyam / G#`.
  step       Float
  series     Series
  /// Absolute Sa as a note name, from the letter after the slash.
  note       String
  /// Absolute Sa as a pitch class, 0..11.
  semitone   Int
  /// Recorded tabla pitch. Always Sa + 7; stored only to verify the source.
  tablaPitch String?
  value      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([semitone])
}

model InstrumentPerson {
  id         String @id @default(cuid())
  instrument String
  person     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instrument, person], name: "instrument_person")
}

/// Mic cushion colours, as the physical cushions on the sound desk.
enum MicColour {
  blue
  grey
  orange
  pink
}

/// Which colour mic cushion a singer is on for a session, for the sound desk.
///
/// Keyed on (sessionId, singerId), not on the slot: a singer has one mic for
/// the whole session, so if they sing twice the cushion follows them. Setting
/// it against any of their slots sets it for all of them.
///
/// Deliberately its own table rather than a column on SessionSlot or Singer:
///
/// 1. SessionSlot.updatedAt drives the roster's optimistic-concurrency guard
///    (app/roster/[id]/actions.ts). A cushion colour living on that row would
///    bump updatedAt, so a sound person tapping a dot would make a
///    coordinator's roster save fail as a "conflict" that is not one — during
///    a live session, which is exactly when both happen at once.
/// 2. Different authorisation: any signed-in user sets this, where the slot
///    itself is editor-controlled.
/// 3. It is per-session, so it cannot live on Singer either.
/// 4. SessionSlot is the historical record. This is live operational state for
///    setting up and EQing mics. It is timestamped, so the history comes for
///    free, but nothing is allowed to depend on it.
///
/// The composite primary key makes every write a single-row upsert, so two
/// people setting different singers can never clobber each other.
model MicCushion {
  sessionId String
  singerId  String

  /// Null is an explicit "cushion removed" state, not an absent row. Clearing
  /// has to reach the other devices, and a deleted row carries no timestamp to
  /// compare against, so removal would be indistinguishable from "not loaded
  /// yet". Keeping the row means every change — including removal — has an
  /// updatedAt, which is what the client merge orders by.
  colour MicColour?

  /// Who set it last. For visibility on the desk, never for authorisation.
  setByName String?

  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  singer  Singer  @relation(fields: [singerId], references: [id], onDelete: Cascade)

  @@id([sessionId, singerId])
  @@index([sessionId])
}

/// A coordinator's decision about which tabla to tune, overriding the rule.
///
/// Keyed on (raga, Sa) because that is what the rule actually depends on: the
/// degrees available come from the raga's notes, and which of them lands on an
/// owned drum comes from Sa. Correcting it once therefore fixes every bhajan in
/// that raga at that pitch, which is what Sailavan asked for — the override
/// should stick and apply in future.
///
/// `raga` is "" for "any raga at this Sa". An empty string rather than NULL so
/// the unique index actually constrains it; Postgres treats NULLs as distinct.
///
/// `note` NULL means "nothing fits, and that is the recorded answer" — a
/// deliberate decision, distinct from never having been asked.
model TablaOverride {
  id String @id @default(cuid())

  /// Lower-cased, "~" stripped, matching lib/ragaScales.ts. "" = any raga.
  raga String @default("")
  /// Pitch class of Sa, 0..11.
  sa   Int

  /// Note name, e.g. "C#". Null records "no tabla fits" as a decision.
  note String?

  /// Why, in the coordinator's words. Shown next to the answer.
  reason String?

  setByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([raga, sa])
  @@index([sa])
}

/// A browser's push endpoint, belonging to a person.
///
/// Keyed on the endpoint because that is what the push service issues and what
/// identifies the device; one person may have several (phone, laptop). Tied to
/// a Singer so a notification reaches a PERSON rather than a browser, which is
/// what "notify whoever is rostered" requires.
///
/// Cascades on the singer: if somebody is removed from the list their devices
/// should stop being pushed to immediately, not linger as orphans.
model PushSubscription {
  id String @id @default(cuid())

  singerId String

  /// The push service URL. Unique — re-subscribing the same browser must
  /// update the existing row rather than accumulate duplicates.
  endpoint String @unique
  p256dh   String
  auth     String

  /// For working out which device this is when pruning. Not shown anywhere.
  userAgent String?

  /// Last time the push service accepted a message. A 404/410 deletes the row
  /// instead — expired endpoints are the normal end of a subscription's life.
  lastOkAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  singer Singer @relation(fields: [singerId], references: [id], onDelete: Cascade)

  @@index([singerId])
}

/// What kind of notice somebody has already had about a session.
enum NoticeKind {
  /// "You are singing on Thursday" — alerts.
  rostered
  /// "The roster for Thursday is up" — silent.
  published
  /// 3pm on the day: "you have not chosen a bhajan yet" — alerts.
  nudge
  /// 5pm on the day, the last one. Nobody is nudged a third time.
  nudge_final
}

/// One row per person per session per kind, so nobody is told twice.
///
/// Rostering happens in bursts: four rows added one after another must not
/// produce four notifications. Recording what has been sent means a later
/// addition notifies only the person newly added, and the quiet
/// "roster is up" goes out once.
model SessionNotice {
  id String @id @default(cuid())

  sessionId String
  singerId  String
  kind      NoticeKind

  sentAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  singer  Singer  @relation(fields: [singerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, singerId, kind])
  @@index([sessionId])
}
