// Naimisha Bhajan Roster — v2 schema.
//
// Changes from v1 follow docs/SPEC.md §5. Read that before editing.
//
// Two columns in this file are historical record and must never be recomputed,
// overwritten, or "cleaned up": SessionSlot.confirmedPitch (what the singer
// actually sang) and SessionSlot.historicalRecommendedPitch (what the sheet
// recommended at the time). The 709 rows carrying them exist nowhere else.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Which reference-pitch track in the masterlist applies to a singer.
/// These are the group's own words; do not translate them.
enum Gender {
  Gents
  Ladies
}

/// Which drone the shruti box plays against Sa. Display metadata only —
/// it does NOT change the pitch. See CLAUDE.md rule 2.
enum Series {
  Madhyam
  Pancham
}

enum SessionType {
  Weekday
  Sunday
  Festival
}

/// What a session IS — a set of bhajans, or a music program.
///
/// Separate from SessionType, which says which kind of occasion it is. A
/// program is a Session so the calendar, the several-a-day handling, the
/// category mark and the meta fields all work unchanged; its CONTENT lives in
/// the Program* tables, which is also why nothing that reads SessionSlot can
/// see one. Fairness, pitch history and repertoire are all computed from slots,
/// and a program has none.
enum SessionFormat {
  bhajans
  program
}

/// Which kind of session a category describes. The centre owns both
/// vocabularies and they are not the same vocabulary — "Routine Thursday" is
/// not a music program, and "Musical offering" is not a bhajan session.
enum CategoryScope {
  bhajans
  program
}

/// A sung item, or a passage read between songs.
///
/// Narrations are ITEMS rather than a field on the song that follows: they sit
/// in the running order, they need a person and a mic like anything else, and a
/// program may open or close with one.
enum ProgramItemKind {
  song
  narration
}

/// Which roster offers an instrument. `both` is for the ones that genuinely
/// serve each — a tabla is a tabla.
enum InstrumentScope {
  bhajans
  program
  both
}

/// Who is doing a JOB at a session, as opposed to singing or playing at it.
///
/// An enum rather than a managed list, unlike Instrument: every job here maps
/// to a VIEW, and adding one means writing the screen that goes with it. A job
/// the app has no view for would be a label that does nothing.
///
/// Applies to bhajan sessions as much as to programs — the person on the desk
/// on a Thursday is doing the same job with fewer channels.
enum SessionJob {
  soundEngineer
  micCoordinator
}

enum SessionStatus {
  Draft
  Published
}

/// A singer's relationship to a bhajan.
///
/// `known` and `festival` came from the import. `wantToLearn` and `learning`
/// are the personal list: a singer moves a bhajan along until they are
/// confident, and graduating it to `known` makes it count in the session
/// builder's repertoire scoring with no other wiring.
/// Which way a person likes to see the roster.
enum RosterView {
  calendar
  list
}

enum RepertoireKind {
  known
  /// DEAD as of 2026-08-12 — see SingerRepertoire.isFestival. No row should
  /// carry it; the value stays only because dropping an enum value in Postgres
  /// means rewriting the column, and an unused value costs nothing.
  festival
  wantToLearn
  learning
}

/// Slot rules are mostly advisory. Confirmed with Sailavan (SPEC §9.1): the
/// Ganesha opener and the Sai closer are strong habits, not rules. A `soft`
/// violation is down-weighted and surfaced; it never fails generation.
enum RuleStrength {
  hard
  soft
}

/// Where a bhajan came from. Everything imported from data/roster.xlsx is
/// `masterlist`; anything typed into the app afterwards is `local`, so the
/// group can tell its own additions from the Sai Rhythms masterlist without
/// the distinction being shouted at them.
enum BhajanOrigin {
  masterlist
  local
}

enum Role {
  /// Everything a coordinator can do, plus the notification rules. See
  /// lib/auth.ts — the app deliberately had no owner until the rules for when
  /// people get reminded became something to configure rather than to deploy.
  owner
  coordinator
  singer
  viewer
}

/// When the day-of reminders go out, for one scope.
///
/// The 3pm and 5pm in lib/notify.ts are the fallback. Most sessions are in the
/// evening but some are mornings, and a reminder at 3pm for a session that
/// finished at noon is worse than none — so an owner can say "Sunday runs in
/// the morning" once, or override a single festival, without a deploy.
///
/// Most specific wins: a rule on the session beats one on its weekday, which
/// beats the default. See lib/nudgeRules.ts, where the resolution lives as a
/// pure function.
model NotificationRule {
  id String @id @default(cuid())

  scope RuleScope

  /// 0 = Sunday … 6 = Saturday. Only for scope = weekday.
  weekday   Int?
  /// Only for scope = session.
  sessionId String?

  /// Melbourne hour, 0–23, for the first reminder.
  firstHour     Int
  /// The second and last one. Null means there is only ever one.
  finalHour     Int?
  /// Never send after this hour — people are on their way by then.
  stopAfterHour Int

  /// Off means this scope sends nothing at all.
  enabled Boolean @default(true)

  /// Who last touched it, for the Admin screen. A name, not an id.
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([scope, weekday, sessionId])
  @@index([sessionId])
}

enum RuleScope {
  /// The one rule that applies when nothing more specific does.
  default
  weekday
  session
}

model Singer {
  id     String  @id @default(cuid())
  name   String  @unique
  gender Gender?
  /// Google account address, set by a coordinator. Sign-in never creates a
  /// singer; an unlisted address gets viewer access only (SPEC §9.5).
  email  String? @unique
  role   Role    @default(singer)

  /// Calendar or list, whichever they asked for. Null means they have not
  /// said, and the calendar is what they get. Stored on the person rather
  /// than in a cookie so it follows them from phone to laptop — everybody
  /// signs in, so there is somebody to store it against.
  defaultRosterView RosterView?

  /// May edit song lyrics and meanings, without any other editor power.
  ///
  /// The role matrix in lib/capabilities.ts is otherwise a pure function of the
  /// role. This is the one per-person grant, and it exists because Sailavan
  /// wanted named people keeping the words up to date without handing them the
  /// roster. See canWithGrants().
  canEditWords Boolean  @default(false)
  /// The second per-person grant: this person runs the sound.
  ///
  /// Sailavan wanted the sound engineer and the mic coordinator to keep the
  /// desk and its cushion allocation right without becoming editors — the same
  /// shape of problem as canEditWords, and the same answer. Granted in /admin.
  ///
  /// Deliberately NOT read from SessionCrew, which records who is on the job
  /// for one programme. The cushion allocation is a standing fact about a desk
  /// ("channel 1 is the blue cushion"), so the permission to change it is a
  /// standing fact about a person.
  canRunSound  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  slots              SessionSlot[]
  chorusMics         SessionSlotChorus[]     @relation("ChorusSinger")
  repertoire         SingerRepertoire[]
  availability       SingerAvailability[]
  micCushions        MicCushion[]
  pushSubscriptions  PushSubscription[]
  notices            SessionNotice[]
  programParts       ProgramPerformer[]
  programInstruments ProgramItemInstrument[]
  crew               SessionCrew[]
  deskChannels       SessionChannel[]
  /// Mics this person shares with somebody else. See SessionChannel.withSingerId.
  sharedChannels     SessionChannel[]        @relation("SessionChannelShare")
  sharedItemChannels ProgramItemChannel[]    @relation("ItemChannelShare")
  /// Items where this person is on a strip that is not usually theirs.
  itemChannels       ProgramItemChannel[]
}

model Bhajan {
  id       String  @id @default(cuid())
  title    String  @unique
  url      String?
  singers  String?
  meaning  String? @db.Text
  lyrics   String? @db.Text
  audio    String?
  /// Raw comma/space-delimited source values, kept for provenance.
  /// Query through the join tables below, never with LIKE.
  deity    String?
  language String?
  raga     String?
  beat     String?
  level    String?
  tempo    String?

  referenceGentsPitch      String?
  referenceLadiesPitch     String?
  musicNotesForFirstLine   String? @db.Text
  notesRange               String?
  tutorial                 String?
  sheetMusic               String?
  songTags                 String?
  glossaryTerms            String? @db.Text
  debugFile                String?
  video                    String?
  generalComments          String? @db.Text
  karaokeTracksForPractice String? @db.Text
  goldenVoice              String?
  instrumental             String?
  extra                    String?

  /// Fields the group has corrected since the import. See BhajanFieldEdit.
  fieldEdits BhajanFieldEdit[]

  /// See BhajanOrigin. Defaults to masterlist so the 3,607 imported rows are
  /// unaffected by this column being added.
  origin     BhajanOrigin @default(masterlist)
  /// Free-text note on a locally added bhajan — where it came from, who asked.
  originNote String?

  /// Generated column maintained by Postgres — see the migration. Not
  /// selectable through the client; search via $queryRaw against the GIN index.
  searchVector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots      SessionSlot[]
  repertoire SingerRepertoire[]
  deities    BhajanDeity[]
  tags       BhajanTag[]
  /// The program song that IS this bhajan, when there is one. See Song.
  song       Song?

  @@index([searchVector], type: Gin)
  @@index([raga])
  @@index([tempo])
}

/// 21 values, `Sarva Dharma` meaning multi-faith. A bhajan may list several.
model Deity {
  id   String @id @default(cuid())
  name String @unique

  bhajans BhajanDeity[]
  songs   SongDeity[]
}

model BhajanDeity {
  bhajanId String
  deityId  String

  bhajan Bhajan @relation(fields: [bhajanId], references: [id], onDelete: Cascade)
  deity  Deity  @relation(fields: [deityId], references: [id], onDelete: Cascade)

  @@id([bhajanId, deityId])
  @@index([deityId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  bhajans BhajanTag[]
  songs   SongTag[]
}

model BhajanTag {
  bhajanId String
  tagId    String

  bhajan Bhajan @relation(fields: [bhajanId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bhajanId, tagId])
  @@index([tagId])
}

model Session {
  id   String   @id @default(cuid())
  /// A session date, not a timestamp. Handled in Australia/Melbourne.
  ///
  /// NO LONGER UNIQUE. It was, on the assumption of one session a day, and
  /// Sailavan 2026-08-12: "some days there are 3 sessions". Anywhere that used
  /// to findUnique by date now takes the first by start time.
  date DateTime @db.Date

  /// Roughly when it starts, "HH:MM" in Melbourne. Null means the usual
  /// evening. Stored as a string rather than a DateTime because it is a time
  /// of day, not an instant — a DateTime would carry a date and a zone with it
  /// and invite exactly the UTC-shifts-the-day bug the date column avoids.
  startsAt String?

  /// What kind of session — "Routine Thursday", "Festival". A table rather
  /// than an enum because the centre owns the vocabulary and will change it
  /// without a deploy.
  categoryId String?
  /// What it was about: a festival name, a visiting speaker, a theme.
  topic      String?

  /// Where it was held — the centre, somebody's home, a hall.
  ///
  /// Free text rather than a table, unlike the category. Venues are a long
  /// tail with a handful of repeats, and the form offers what has been used
  /// before, so a list to maintain would cost more than it saves.
  location String?

  /// When the SET OF ROSTERED SINGERS last changed — not when anything on the
  /// session was last touched.
  ///
  /// The difference is the whole point. "Is this roster settled?" must not be
  /// reset by somebody filling in a pitch an hour later: the people are
  /// decided, which is what the quiet "the roster is up" announces. Slot
  /// updatedAt cannot answer it, because every pitch edit bumps that too.
  rosterChangedAt     DateTime?
  /// Which desk this programme is mixed on. Null until one is picked.
  deskId              String?
  /// Which item in the running order the programme is ON right now.
  ///
  /// A POSITION, not an item id, so it survives an item being deleted mid-
  /// programme — the desk lands on whatever now holds that place rather than on
  /// nothing at all. Read through `currentItemOf`, which clamps it to the items
  /// that actually exist.
  ///
  /// Shared deliberately: the point of the desk view is that the desk, the
  /// stage and anybody watching are on the same item, so this is one fact about
  /// the programme rather than one per device. Null until somebody starts, which
  /// reads as "we have not begun".
  currentItemPosition Int?
  type                SessionType   @default(Weekday)
  /// See SessionFormat. Defaults to `bhajans` so every existing row is
  /// unaffected by this column arriving.
  format              SessionFormat @default(bhajans)
  status              SessionStatus @default(Published)
  /// Seed for the generator, so a generated set is reproducible and shareable.
  seed                String?
  templateId          String?
  notes               String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  template          SessionTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  slots             SessionSlot[]
  instruments       SessionInstrument[]
  micCushions       MicCushion[]
  notices           SessionNotice[]
  notificationRules NotificationRule[]
  programItems      ProgramItem[]
  crew              SessionCrew[]
  channels          SessionChannel[]
  desk              Desk?               @relation(fields: [deskId], references: [id], onDelete: SetNull)

  category SessionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// At most one — it is keyed by session. A list because Prisma cannot express
  /// "one optional row on the other side of a one-to-one whose id IS the key".
  harmoniumNotice HarmoniumNotice[]

  @@index([templateId])
  @@index([date])
  @@index([categoryId])
}

/// One ordered slot in a session: a singer, a bhajan, and the pitch they sang.
/// Renamed from v1's `SessionSinger`; `slot Int?` became `position Int`.
/// The kinds of session the centre runs. Owned by the group, not by the code.
model SessionCategory {
  id    String        @id @default(cuid())
  /// Unique across BOTH scopes, deliberately. Two kinds with the same name and
  /// different scopes would be indistinguishable everywhere they are shown.
  name  String        @unique
  /// Which vocabulary this belongs to. Existing rows are all bhajan kinds.
  scope CategoryScope @default(bhajans)
  /// Sort order in the picker. Lower first.
  order Int           @default(0)

  /// A small square image for this kind of session, as a data URL.
  ///
  /// In the database rather than a file store because there are a handful of
  /// categories, not thousands of photos: the browser shrinks each one to
  /// 256px before it is ever uploaded, so a row costs a few tens of kilobytes
  /// and travels with the ordinary backups. If this ever grows into session
  /// photographs it wants Azure Blob Storage instead — that is a different
  /// feature, not this one grown large.
  image String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
}

/// One field of one bhajan that the group has changed since the import.
///
/// The masterlist is a copy of somebody else's spreadsheet — 3,613 rows the
/// centre does not own — and `data/roster.xlsx` is never written back to. So
/// when the group corrects a raga or fills in a missing pitch, two things have
/// to stay true: the correction wins everywhere, and it is still possible to
/// see that it IS a correction and what the source said.
///
/// One row per (bhajan, field), written the FIRST time that field is changed.
/// `sourceValue` is therefore what the masterlist had, not the previous edit —
/// correcting a correction does not lose the original.
model BhajanFieldEdit {
  id       String @id @default(cuid())
  bhajanId String
  /// The Prisma field name, e.g. "raga". Whitelisted — see lib/bhajanFields.ts.
  field    String

  /// What it was before the group touched it. Null when the source was blank,
  /// which is the common case: 565 bhajans have no raga recorded.
  sourceValue String? @db.Text

  editedBy  String?
  editedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  bhajan Bhajan @relation(fields: [bhajanId], references: [id], onDelete: Cascade)

  @@unique([bhajanId, field])
  @@index([bhajanId])
}

model SessionSlot {
  id        String  @id @default(cuid())
  sessionId String
  /// Null until a singer is assigned. The session builder chooses bhajans
  /// first and drafts a session with unassigned slots; rostering fills these
  /// in. Also `SetNull` rather than `Cascade`: removing a singer must never
  /// silently delete their confirmedPitch history.
  singerId  String?
  bhajanId  String?
  /// Ordered from 1. Order carries meaning — the set builds.
  position  Int

  /// Free-text fallbacks preserved from the sheet for rows whose title does not
  /// resolve to a masterlist bhajan.
  bhajanTitle           String?
  festivalBhajanTitle   String?
  inputOnlyCustomBhajan String?

  /// HISTORICAL RECORD. What the singer actually sang at. Differs from the
  /// recommendation in 381 of 611 rows; that difference is the product.
  /// Never overwrite this with a computed value.
  confirmedPitch String?

  /// HISTORICAL RECORD. The recommendation as it stood in the source sheet
  /// (`Recommended Pitch as Sai Rythms`). CLAUDE.md rule 5 says the app's live
  /// recommendation is derived from the masterlist and never stored — that
  /// still holds, and nothing reads this column to produce one. It is kept
  /// because the singer-offset regression table is defined against it and must
  /// reproduce from the database. Of the 618 rows where both this and a
  /// masterlist reference exist, 617 agree; the one that does not is a known
  /// typo, logged at seed time.
  historicalRecommendedPitch String?

  alternativeTablaPitch String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  singer  Singer? @relation(fields: [singerId], references: [id], onDelete: SetNull)
  bhajan  Bhajan? @relation(fields: [bhajanId], references: [id], onDelete: SetNull)

  /// Who is on a chorus mic for this bhajan. See SessionSlotChorus.
  chorus SessionSlotChorus[]

  @@unique([sessionId, position])
  @@index([sessionId])
  @@index([singerId])
  @@index([bhajanId])
}

/// One person on one chorus mic, for one bhajan.
///
/// This began as two columns on SessionSlot — `chorusSingerId` and
/// `chorusCushion` — which said one person choruses a bhajan. In real use more
/// than one does, each on their own mic with its own cushion, so the pair
/// became a table (2026-08-17). The four dev rows that existed were carried
/// across as first entries.
///
/// The cushion stays HERE rather than on the singer, which is the same reason
/// the columns were on the row before. MicCushion is keyed (session, singer)
/// because a lead singer has one mic for the whole evening; a chorus mic is a
/// different mic, and the same person may lead bhajan 1 on blue and chorus
/// bhajan 3 on green. Keyed by person, those two facts cannot both be true.
///
/// Cascade on both sides, unlike SessionSlot.singerId, and it is safe here for
/// a reason that does not apply there: this row holds no history. It records
/// who is on a mic tonight, so removing the bhajan or the singer should take it
/// with them — whereas a SessionSlot holds `confirmedPitch`, which must survive
/// a singer being removed.
model SessionSlotChorus {
  id       String @id @default(cuid())
  slotId   String
  singerId String

  /// The colour of THIS mic's cushion. Null is "no cushion", which is a state
  /// somebody can deliberately choose, exactly as with the lead mics.
  cushion MicColour?

  /// Ordered from 1, so the live board reads the mics in the same order on
  /// every device rather than in whatever order the rows come back.
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slot   SessionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  singer Singer      @relation("ChorusSinger", fields: [singerId], references: [id], onDelete: Cascade)

  /// One person cannot be on two chorus mics for the same bhajan.
  @@unique([slotId, singerId])
  @@index([slotId])
  @@index([singerId])
}

model SessionInstrument {
  id         String  @id @default(cuid())
  sessionId  String
  instrument String
  person     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// One entry in a music program's running order.
///
/// A program is a Session with `format = program`; this is its content. The
/// bhajan roster's SessionSlot could not carry it: a slot is one singer at one
/// shruti, and a program item is a rehearsed piece with several singers, its own
/// instruments, and a pitch written as a bare note.
model ProgramItem {
  id        String @id @default(cuid())
  sessionId String

  /// Ordered from 1. Narrations take positions too, so the running order is one
  /// list. The number the group SAYS out loud counts only the songs — see
  /// lib/program.ts `songNumbers`, which derives it.
  position Int
  kind     ProgramItemKind @default(song)

  /// The passage, for kind = narration. The reader is a ProgramPerformer with
  /// part = "reader", so a guest reader needs nothing new.
  narration String? @db.Text

  songId String?
  /// The title as written, for an item whose song is not catalogued yet, or a
  /// heading for a narration.
  title  String?

  /// A BARE NOTE, e.g. "A#". Programs record pitch as the note alone — no
  /// `2 Pancham / D` appears in any of the four source documents. See
  /// lib/pitch.ts `saOfNote`, which reads this; `saOf` needs the slash.
  pitchNote  String?
  /// The full shruti label when one is known, so nothing is lost if it is.
  pitchLabel String?

  bpm          Int?
  /// The scene to recall on a desk that has scenes. Nothing reads it yet; it
  /// is printed on the sheet so the operator can programme them once.
  sceneNumber  Int?
  /// The recording being learnt from.
  referenceUrl String?
  /// Choral cues, swara interludes, repeat marks — the working notes that sit
  /// beside a piece and are not its lyrics.
  arrangement  String? @db.Text
  notes        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session     Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // SetNull, never Cascade: removing a song from the catalogue must not delete
  // the record of a program that sang it. The item keeps its own title.
  song        Song?                   @relation(fields: [songId], references: [id], onDelete: SetNull)
  performers  ProgramPerformer[]
  instruments ProgramItemInstrument[]
  channels    ProgramItemChannel[]

  @@unique([sessionId, position])
  @@index([sessionId])
  @@index([songId])
}

/// Who sings, or reads, one program item.
///
/// `singerId` OR `name`, never neither. Half of the performers in the source
/// documents are not roster singers — `Psais`, `All girls`, `Radhika aunty` —
/// and forcing them into the Singer table would put guests and groups into the
/// fairness rotation, the availability calendar and the notification lists.
model ProgramPerformer {
  id       String  @id @default(cuid())
  itemId   String
  singerId String?
  /// A guest or a group, when there is no Singer row.
  name     String?
  /// "lead", "chorus", "tenor", "base", "Boys", "reader".
  part     String?
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item   ProgramItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  singer Singer?     @relation(fields: [singerId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([singerId])
}

/// The instruments the centre plays. Managed in /admin — not free text.
///
/// `InstrumentPerson` keys eligibility by instrument NAME, and
/// lib/instrumentScoring.ts scores off those names, so a rename here has to
/// carry those rows with it and a retirement is a flag rather than a delete —
/// otherwise a past program would lose what was played on it.
model Instrument {
  id     String          @id @default(cuid())
  name   String          @unique
  order  Int             @default(0)
  scope  InstrumentScope @default(program)
  active Boolean         @default(true)

  /// How many desk channels this instrument needs.
  ///
  /// One for nearly everything, and not for everything: a two-headed drum — a
  /// dholak, a mridangam, a khol — is miked on each head and takes two strips,
  /// and a stereo keyboard takes two. Building the channel list from a
  /// programme's players used to give each instrument one strip and leave
  /// somebody to notice, on the night, that the mridangam had half a mic.
  ///
  /// Read by lib/deskChannels.ts `proposeChannels`, which numbers the extra
  /// strips and labels them "Mridangam 1", "Mridangam 2".
  channels Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programItems    ProgramItemInstrument[]
  sessionChannels SessionChannel[]
  /// Items where this instrument takes over a strip that is not usually its —
  /// a singer's mic on the mridangam for one song.
  itemChannels    ProgramItemChannel[]
}

/// One instrument on one program item, and who is playing it.
model ProgramItemInstrument {
  id           String  @id @default(cuid())
  itemId       String
  instrumentId String
  singerId     String?
  /// The player when they are not a Singer row — the documents name several.
  person       String?
  order        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item       ProgramItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  instrument Instrument  @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  singer     Singer?     @relation(fields: [singerId], references: [id], onDelete: SetNull)

  @@unique([itemId, instrumentId])
  @@index([itemId])
  @@index([instrumentId])
}

/// A song sung at a music program.
///
/// Its own catalogue, not part of the 3,613-row bhajan masterlist. The
/// masterlist is a copy of somebody else's spreadsheet of Sai bhajans; these
/// are Meera bhajans, Carnatic kritis, Odia and Marathi abhangs and the
/// occasional English piece, which the centre owns and edits itself.
///
/// `bhajanId` is a SOFT LINK for the overlap — "Om Sai Om Sai Om" and "Madhura
/// Mohana" are both program songs and masterlist bhajans. A pointer, so the
/// details page can offer the bhajan's own record; never a merge, or the two
/// catalogues would have to agree about everything forever.
model Song {
  id        String  @id @default(cuid())
  title     String  @unique
  language  String?
  /// "Meera bhajan", "Carnatic kriti", "Odia bhajan" — how the group would
  /// describe where it comes from.
  tradition String?
  composer  String?

  /// The recording the group learns it from.
  referenceUrl String?
  audio        String?
  bpm          Int?
  notes        String? @db.Text

  bhajanId String? @unique

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bhajan  Bhajan?       @relation(fields: [bhajanId], references: [id], onDelete: SetNull)
  verses  SongVerse[]
  deities SongDeity[]
  tags    SongTag[]
  items   ProgramItem[]

  @@index([tradition])
}

/// One section of a song — a Pallavi, a Charanam, a Chorus — in up to three
/// layers.
///
/// Three columns rather than one, because the group's documents keep all three
/// and each is read by different people: the script by whoever reads that
/// script, the transliteration by everybody singing, the meaning by anybody
/// wanting to know what they are singing.
///
/// Whether the layers are shown line by line or as blocks is NOT stored: it is
/// derived from whether they have the same number of lines. See
/// lib/songVerses.ts — the two source documents write these two different ways
/// and both have to render honestly.
model SongVerse {
  id     String @id @default(cuid())
  songId String
  order  Int

  /// "Pallavi", "Charanam 2", "Chorus". Free text with suggestions rather
  /// than an enum: the group writes its own — "Swaras", "Interlude" — and a
  /// label the app does not recognise is still a perfectly good label.
  label String?

  /// The words as written — Tamil, Devanagari, Telugu, Marathi.
  script  String? @db.Text
  /// The same words in Latin script, which is what most people sing from.
  roman   String? @db.Text
  /// What it means, in English.
  meaning String? @db.Text

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, order])
  @@index([songId])
}

/// Songs join the EXISTING Deity and Tag tables rather than growing their own.
/// The catalogues are separate; the vocabularies are the centre's and are not.
model SongDeity {
  songId  String
  deityId String

  song  Song  @relation(fields: [songId], references: [id], onDelete: Cascade)
  deity Deity @relation(fields: [deityId], references: [id], onDelete: Cascade)

  @@id([songId, deityId])
  @@index([deityId])
}

model SongTag {
  songId String
  tagId  String

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([songId, tagId])
  @@index([tagId])
}

/// What a channel carries. Decides how it is grouped and read on the sheet.
enum ChannelKind {
  vocal
  instrument
  /// A backing track played through the system — the birthday programme's
  /// English song was sung to one.
  track
  spare
}

enum DeskKind {
  analog
  digital
}

/// A mixing desk the centre uses, and the strips printed on it.
///
/// A TEMPLATE, not a programme's actual channel list. Picking a desk for a
/// programme copies these strips into SessionChannel rows, which is what gets
/// edited from then on — so correcting a label here next year cannot rewrite
/// what a programme two years ago says was on channel 6.
///
/// `protocol`, `host` and `port` are null for an analog desk and mean nothing
/// to the app today. They exist because the centre is considering an Allen &
/// Heath SQ5, which speaks MIDI over TCP; a bridge on a laptop in the hall
/// would read them. Nothing in the browser can reach a desk on the hall LAN.
model Desk {
  id        String   @id @default(cuid())
  name      String   @unique
  kind      DeskKind @default(analog)
  protocol  String?
  host      String?
  port      Int?
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// How many inputs are mono before the rest pair up.
  ///
  /// Twelve on the centre's MG20XU — Yamaha's "Mono[MIC/LINE]: 12;
  /// Mono/Stereo[MIC/LINE]: 4" — so 13/14, 15/16, 17/18 and 19/20 are the only
  /// strips that can be a pair. Sailavan, 2026-08-17: "from 13 onwards they are
  /// all capable of being stereo, not before there."
  ///
  /// A property of the DESK because it is a fact about the hardware, and the
  /// next desk will have a different one.
  monoInputs Int @default(12)

  channels DeskChannel[]
  sessions Session[]
}

/// One strip on a desk, as it is numbered on the metal.
model DeskChannel {
  id     String @id @default(cuid())
  deskId String

  /// The channel strip, as printed on the desk.
  number Int
  /// The physical input socket when it differs from the strip. It always can
  /// on a digital desk and never does on the Yamaha.
  socket Int?
  label  String
  kind   ChannelKind @default(vocal)
  /// A MONO/STEREO strip, whose number is the first of its pair.
  ///
  /// The centre's MG20XU has sixteen strips: twelve mono (1-12) and four
  /// mono/stereo (13/14, 15/16, 17/18, 19/20) — Yamaha's own words, and the
  /// reason this is a property of the DESK. Whether such a strip is being used
  /// as a stereo pair or as one mono channel is a decision per programme, not
  /// per desk, so that lives on SessionChannel.
  stereo Boolean     @default(false)
  /// For a vocal strip whose mic wears a coloured cushion.
  ///
  /// The cushions are FIXED to channels and do not move: channel 1 is the blue
  /// cushion every week. That is why this lives on the desk rather than on a
  /// programme — it describes the hardware, and a programme copies it.
  colour MicColour?
  /// Which mic is actually on the strip — "Wired", "Pegasus", "WL1", "Rode".
  ///
  /// Free text on purpose. This is the sound person's own shorthand for their
  /// own gear, it changes when a mic is replaced, and a managed list of mic
  /// models would be a table to maintain for something nothing computes on.
  mic    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  desk Desk @relation(fields: [deskId], references: [id], onDelete: Cascade)

  @@unique([deskId, number])
  @@index([deskId])
}

/// One channel as it stands FOR ONE PROGRAMME: the strip, and who is on it.
///
/// Snapshotted from the desk when one is picked, then edited freely. That copy
/// is the point: a programme is a record of an evening, and the desk template
/// changes between evenings.
model SessionChannel {
  id        String @id @default(cuid())
  sessionId String

  number String
  label  String
  kind   ChannelKind @default(vocal)

  /// Whether THIS programme is using the strip as a stereo pair.
  ///
  /// Only meaningful on a strip the desk says is mono/stereo. Sailavan: if it
  /// is going to be a mono channel then 13/14 is one channel — and that is a
  /// decision taken per programme, because it depends on what is plugged into
  /// it that night, not on the desk. Copied from the desk as the starting
  /// point and corrected here.
  stereo Boolean @default(false)

  colour MicColour?

  /// Who or what is on it. A roster singer, a name typed in, or an instrument
  /// from the managed list — the same three answers as everywhere else in a
  /// programme, for the same reason.
  singerId     String?
  person       String?
  instrumentId String?
  note         String?
  /// Which mic is on the strip, copied from the desk and correctable here.
  mic          String?

  /// A SECOND person sharing this mic.
  ///
  /// Two singers on one channel is a real thing — a duet taken on one mic, or a
  /// pair leaning in for a chorus — and the desk has to know both names or it
  /// will bring the wrong one up. Two, not a list: "split a mic between 2
  /// people" is what was asked for, and a list would need a table and a UI for a
  /// case nobody has yet.
  ///
  /// Same three answers as the first, minus the instrument: a mic shared between
  /// a person and a drum is two channels, not one.
  withSingerId String?
  withPerson   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session    Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  singer     Singer?              @relation(fields: [singerId], references: [id], onDelete: SetNull)
  withSinger Singer?              @relation("SessionChannelShare", fields: [withSingerId], references: [id], onDelete: SetNull)
  instrument Instrument?          @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  items      ProgramItemChannel[]

  @@unique([sessionId, number])
  @@index([sessionId])
}

/// Which channels are open for one item. The artefact a document cannot hold.
///
/// Doubles as the scene plan for a desk that has scenes: one scene per item,
/// and this is the mute map it would be programmed from.
model ProgramItemChannel {
  itemId    String
  channelId String
  open      Boolean @default(false)
  note      String?

  /// WHO OR WHAT IS ON THIS STRIP FOR THIS ITEM, when it is not the usual
  /// occupant.
  ///
  /// A mic does not belong to one person all evening. Sailavan: a mic used for
  /// a singer will, on another song, be used for an instrument — or for one
  /// side of a two-headed drum, where a dholak or a mridangam is miked twice
  /// and each head is its own strip. Without this the desk view would name the
  /// singer on channel 3 for a song where channel 3 is the mridangam, which is
  /// worse than saying nothing.
  ///
  /// All three are overrides and all three are null in the ordinary case,
  /// where the channel's own occupant stands. Same three answers as
  /// SessionChannel — a roster singer, a name typed in, or a managed
  /// instrument — because it is the same question asked per item.
  singerId     String?
  person       String?
  instrumentId String?

  /// A SECOND person sharing this mic.
  ///
  /// Two singers on one channel is a real thing — a duet taken on one mic, or a
  /// pair leaning in for a chorus — and the desk has to know both names or it
  /// will bring the wrong one up. Two, not a list: "split a mic between 2
  /// people" is what was asked for, and a list would need a table and a UI for a
  /// case nobody has yet.
  ///
  /// Same three answers as the first, minus the instrument: a mic shared between
  /// a person and a drum is two channels, not one.
  withSingerId String?
  withPerson   String?

  updatedAt DateTime @updatedAt

  item       ProgramItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  channel    SessionChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  singer     Singer?        @relation(fields: [singerId], references: [id], onDelete: SetNull)
  withSinger Singer?        @relation("ItemChannelShare", fields: [withSingerId], references: [id], onDelete: SetNull)
  instrument Instrument?    @relation(fields: [instrumentId], references: [id], onDelete: SetNull)

  @@id([itemId, channelId])
  @@index([channelId])
  @@index([singerId])
  @@index([instrumentId])
}

/// Somebody doing a job at a session rather than singing at it.
///
/// The point is the VIEW: a person crewed on a session lands on the screen for
/// their job when they open it, instead of hunting for it. See
/// lib/sessionView.ts, where that decision is a pure function.
model SessionCrew {
  id        String     @id @default(cuid())
  sessionId String
  singerId  String
  job       SessionJob
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  singer  Singer  @relation(fields: [singerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, singerId, job])
  @@index([sessionId])
  @@index([singerId])
}

/// What a singer knows or has curated for a festival. Replaces v1's
/// `FestivalBhajan` and the two wide sheets it came from.
model SingerRepertoire {
  id       String         @id @default(cuid())
  singerId String
  bhajanId String?
  /// Title as written in the source sheet, kept even when it resolves.
  title    String
  kind     RepertoireKind
  order    Int?

  /// This is one of the bhajans they do at festivals.
  ///
  /// A FLAG, not a stage. `festival` used to be a value of RepertoireKind,
  /// which meant the same bhajan appeared twice on a singer's page — once as
  /// "festival" and once as "known" — because the two came from two different
  /// sheets at seed time. Sailavan, 2026-08-12: "festival songs are not songs
  /// that were sung, they were just songs for people to learn or that they
  /// know." Being a festival bhajan describes the song; wanting to learn it,
  /// learning it and knowing it are the stages, and a song is at exactly one
  /// of them.
  isFestival Boolean @default(false)

  /// The singer's own note — what they are finding hard, where they heard it.
  /// Visible to them and to editors only.
  note           String?
  /// The shruti this singer wants for it, if they have settled on one.
  /// Overrides the derived recommendation for them on this bhajan.
  preferredPitch String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  singer Singer  @relation(fields: [singerId], references: [id], onDelete: Cascade)
  bhajan Bhajan? @relation(fields: [bhajanId], references: [id], onDelete: SetNull)

  @@unique([singerId, kind, title])
  @@index([singerId])
  @@index([bhajanId])
}

model SingerAvailability {
  id        String   @id @default(cuid())
  singerId  String
  date      DateTime @db.Date
  available Boolean  @default(true)
  note      String?

  singer Singer @relation(fields: [singerId], references: [id], onDelete: Cascade)

  @@unique([singerId, date])
  @@index([date])
}

/// Templates are data, editable in the UI. Do not hard-code them.
model SessionTemplate {
  id            String  @id @default(cuid())
  name          String  @unique
  description   String?
  /// Default session length. 3, per SPEC §9.2.
  defaultLength Int     @default(3)
  isDefault     Boolean @default(false)
  /// Festival mode: constrain every slot to this deity, as a HARD rule.
  /// Null for ordinary templates. Generalises beyond Shivaratri (SPEC §4.G).
  singleDeity   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules    SlotRule[]
  sessions Session[]
}

model SlotRule {
  id         String       @id @default(cuid())
  templateId String
  /// 1-based. Negative counts from the end: -1 is the final slot.
  position   Int
  strength   RuleStrength @default(soft)
  /// Constraint fields. Null means "no constraint on this dimension".
  deity      String?
  tempoIn    String[]     @default([])
  note       String?

  template SessionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@index([templateId])
}

/// The 24 shruti labels. Renamed from v1's `PitchLookup`; the pitch maths is
/// now first-class columns rather than something parsed at read time.
model PitchLabel {
  id         String  @id @default(cuid())
  label      String  @unique
  /// The numeric step in the label, e.g. 2.5 in `2.5 Madhyam / G#`.
  step       Float
  series     Series
  /// Absolute Sa as a note name, from the letter after the slash.
  note       String
  /// Absolute Sa as a pitch class, 0..11.
  semitone   Int
  /// Recorded tabla pitch. Always Sa + 7; stored only to verify the source.
  tablaPitch String?
  value      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([semitone])
}

model InstrumentPerson {
  id         String @id @default(cuid())
  instrument String
  person     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instrument, person], name: "instrument_person")
}

/// Mic cushion colours, as the physical cushions on the sound desk.
///
/// `green` arrived with the chorus mic (2026-08-14). Added at the END: these
/// are stored values, and Postgres orders an enum by declaration, so inserting
/// it among the others would reorder every existing sort.
enum MicColour {
  blue
  grey
  orange
  pink
  green
}

/// Which colour mic cushion a singer is on for a session, for the sound desk.
///
/// Keyed on (sessionId, singerId), not on the slot: a singer has one mic for
/// the whole session, so if they sing twice the cushion follows them. Setting
/// it against any of their slots sets it for all of them.
///
/// Deliberately its own table rather than a column on SessionSlot or Singer:
///
/// 1. SessionSlot.updatedAt drives the roster's optimistic-concurrency guard
///    (app/roster/[id]/actions.ts). A cushion colour living on that row would
///    bump updatedAt, so a sound person tapping a dot would make a
///    coordinator's roster save fail as a "conflict" that is not one — during
///    a live session, which is exactly when both happen at once.
/// 2. Different authorisation: any signed-in user sets this, where the slot
///    itself is editor-controlled.
/// 3. It is per-session, so it cannot live on Singer either.
/// 4. SessionSlot is the historical record. This is live operational state for
///    setting up and EQing mics. It is timestamped, so the history comes for
///    free, but nothing is allowed to depend on it.
///
/// The composite primary key makes every write a single-row upsert, so two
/// people setting different singers can never clobber each other.
model MicCushion {
  sessionId String
  singerId  String

  /// Null is an explicit "cushion removed" state, not an absent row. Clearing
  /// has to reach the other devices, and a deleted row carries no timestamp to
  /// compare against, so removal would be indistinguishable from "not loaded
  /// yet". Keeping the row means every change — including removal — has an
  /// updatedAt, which is what the client merge orders by.
  colour MicColour?

  /// Who set it last. For visibility on the desk, never for authorisation.
  setByName String?

  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  singer  Singer  @relation(fields: [singerId], references: [id], onDelete: Cascade)

  @@id([sessionId, singerId])
  @@index([sessionId])
}

/// A coordinator's decision about which tabla to tune, overriding the rule.
///
/// Keyed on (raga, Sa) because that is what the rule actually depends on: the
/// degrees available come from the raga's notes, and which of them lands on an
/// owned drum comes from Sa. Correcting it once therefore fixes every bhajan in
/// that raga at that pitch, which is what Sailavan asked for — the override
/// should stick and apply in future.
///
/// `raga` is "" for "any raga at this Sa". An empty string rather than NULL so
/// the unique index actually constrains it; Postgres treats NULLs as distinct.
///
/// `note` NULL means "nothing fits, and that is the recorded answer" — a
/// deliberate decision, distinct from never having been asked.
model TablaOverride {
  id String @id @default(cuid())

  /// Lower-cased, "~" stripped, matching lib/ragaScales.ts. "" = any raga.
  raga String @default("")
  /// Pitch class of Sa, 0..11.
  sa   Int

  /// Note name, e.g. "C#". Null records "no tabla fits" as a decision.
  note String?

  /// Why, in the coordinator's words. Shown next to the answer.
  reason String?

  setByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([raga, sa])
  @@index([sa])
}

/// A browser's push endpoint, belonging to a person.
///
/// Keyed on the endpoint because that is what the push service issues and what
/// identifies the device; one person may have several (phone, laptop). Tied to
/// a Singer so a notification reaches a PERSON rather than a browser, which is
/// what "notify whoever is rostered" requires.
///
/// Cascades on the singer: if somebody is removed from the list their devices
/// should stop being pushed to immediately, not linger as orphans.
model PushSubscription {
  id String @id @default(cuid())

  singerId String

  /// The push service URL. Unique — re-subscribing the same browser must
  /// update the existing row rather than accumulate duplicates.
  endpoint String @unique
  p256dh   String
  auth     String

  /// For working out which device this is when pruning. Not shown anywhere.
  userAgent String?

  /// Last time the push service accepted a message. A 404/410 deletes the row
  /// instead — expired endpoints are the normal end of a subscription's life.
  lastOkAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  singer Singer @relation(fields: [singerId], references: [id], onDelete: Cascade)

  @@index([singerId])
}

/// What kind of notice somebody has already had about a session.
enum NoticeKind {
  /// "You are singing on Thursday" — alerts.
  rostered
  /// "The roster for Thursday is up" — silent.
  published
  /// 3pm on the day: "you have not chosen a bhajan yet" — alerts.
  nudge
  /// 5pm on the day, the last one. Nobody is nudged a third time.
  nudge_final
}

/// One row per person per session per kind, so nobody is told twice.
///
/// Rostering happens in bursts: four rows added one after another must not
/// produce four notifications. Recording what has been sent means a later
/// addition notifies only the person newly added, and the quiet
/// "roster is up" goes out once.
/// What the harmonium players were last told about a session.
///
/// A ledger AND a snapshot, and it has to be both. The ledger half stops the
/// summary going out twice; the snapshot half is what lets a later edit be
/// described as "Sai Ram #2 is now at 3 Pancham / G" rather than "something
/// changed", which is the difference between a useful notice and noise.
///
/// Not SessionNotice, which is unique on (session, singer, kind) and therefore
/// records a thing happening ONCE. Changes happen repeatedly and are about the
/// session rather than about each recipient, so they need their own row.
model HarmoniumNotice {
  sessionId String @id

  /// The bhajans and shrutis exactly as last sent, as HarmoniumLine[].
  /// Compared against the session on every later save.
  lines Json

  sentAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SessionNotice {
  id String @id @default(cuid())

  sessionId String
  singerId  String
  kind      NoticeKind

  sentAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  singer  Singer  @relation(fields: [singerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, singerId, kind])
  @@index([sessionId])
}
